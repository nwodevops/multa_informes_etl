<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>wf_main</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <description>Corrida: Reset H2 mem → Python STG DDL → pipeline demo → Run Python → Success (smoke test). Diseño STG: wf_create_stg.hwf</description>
  <extended_description/>
  <workflow_version/>
  <created_user>-</created_user>
  <created_date>2026/08/05 10:00:00.000</created_date>
  <modified_user>-</modified_user>
  <modified_date>2026/08/05 10:00:00.000</modified_date>
  <parameters>
    </parameters>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <DayOfMonth>1</DayOfMonth>
      <doNotWaitOnFirstExecution>N</doNotWaitOnFirstExecution>
      <hour>12</hour>
      <intervalMinutes>60</intervalMinutes>
      <intervalSeconds>0</intervalSeconds>
      <minutes>0</minutes>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <weekDay>1</weekDay>
      <parallel>N</parallel>
      <xloc>48</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Reset H2 clean</name>
      <description>stop + start H2 mem + DDL (00_reset.sql + 01_schema.sql)</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>set -e
cd "${PROJECT_HOME}"
./h2/scripts/reset_and_create.sh
</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>208</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Pipeline demo</name>
      <description>H2 → H2 (pl_demo.hpl): lee DEMO_TABLA_EJEMPLO</description>
      <type>PIPELINE</type>
      <attributes/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <clear_files>N</clear_files>
      <clear_rows>N</clear_rows>
      <create_parent_folder>N</create_parent_folder>
      <exec_per_row>N</exec_per_row>
      <filename>${PROJECT_HOME}/pipelines/pl_demo.hpl</filename>
      <logext/>
      <logfile/>
      <loglevel>Basic</loglevel>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
      </parameters>
      <params_from_previous>N</params_from_previous>
      <run_configuration>local</run_configuration>
      <set_append_logfile>N</set_append_logfile>
      <set_logfile>N</set_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <parallel>N</parallel>
      <xloc>512</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Python create STG</name>
      <description>inputs.yaml → introspect fuentes → CREATE TABLE STG_* en H2 (no extrae filas)</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>set -e
cd "${PROJECT_HOME}"
PY=python3
[ -x .venv/bin/python ] &amp;&amp; PY=.venv/bin/python
"$PY" python/create_stg.py
</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>352</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Run Python</name>
      <description>python/main.py: lee H2, ejecuta la logica (unico .py en python/logica/) y escribe Excel/MySQL/Oracle</description>
      <type>SHELL</type>
      <attributes/>
      <filename/>
      <work_directory>${PROJECT_HOME}</work_directory>
      <arg_from_previous>N</arg_from_previous>
      <exec_per_row>N</exec_per_row>
      <set_logfile>N</set_logfile>
      <logfile/>
      <set_append_logfile>N</set_append_logfile>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <insertScript>Y</insertScript>
      <script>set -e
cd "${PROJECT_HOME}"
PY=python3
[ -x .venv/bin/python ] &amp;&amp; PY=.venv/bin/python
"$PY" python/main.py
</script>
      <loglevel>Basic</loglevel>
      <parallel>N</parallel>
      <xloc>672</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>832</xloc>
      <yloc>192</yloc>
      <attributes_hac/>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>Reset H2 clean</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>Reset H2 clean</from>
      <to>Python create STG</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Python create STG</from>
      <to>Pipeline demo</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Pipeline demo</from>
      <to>Run Python</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>Run Python</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads>
    <notepad>
      <backgroundcolorblue>251</backgroundcolorblue>
      <backgroundcolorgreen>232</backgroundcolorgreen>
      <backgroundcolorred>201</backgroundcolorred>
      <bordercolorblue>90</bordercolorblue>
      <bordercolorgreen>58</bordercolorgreen>
      <bordercolorred>14</bordercolorred>
      <fontbold>N</fontbold>
      <fontcolorblue>90</fontcolorblue>
      <fontcolorgreen>58</fontcolorgreen>
      <fontcolorred>14</fontcolorred>
      <fontitalic>N</fontitalic>
      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <height>90</height>
      <xloc>48</xloc>
      <yloc>48</yloc>
      <note>CORRIDA / smoke (no uses este workflow para mapear STG por primera vez).
Diseño: Play workflows/wf_create_stg.hwf (deja H2 vivo) y luego pinta pl_stage_*.hpl.
H2 se resetea en cada corrida: stop + start + DDL (h2/scripts/reset_and_create.sh).
Python create STG: lee inputs.yaml, CREATE TABLE STG_* (sources: [] = no-op).
Pipeline demo: lee DEMO_TABLA_EJEMPLO. Cablear extract (pl_stage_*) DESPUES de Python.
Run Python: python/main.py. Conexiones: h2 / oracle_sisud / oracle_repocsep / mysql.</note>
      <width>720</width>
    </notepad>
  </notepads>
  <attributes/>
</workflow>
