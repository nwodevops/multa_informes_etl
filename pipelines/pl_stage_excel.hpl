<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <name>pl_stage_excel</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Excel local legacy CAGR DIC_* -&gt; H2. Multas/Etapas F2 van por Google Sheets (stage_csep_sheets.sh).</description>
    <extended_description/>
    <pipeline_version/>
    <pipeline_type>Normal</pipeline_type>
    <parameters>
    </parameters>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <created_user>-</created_user>
    <created_date>2026/09/05 19:10:00.000</created_date>
    <modified_user>-</modified_user>
    <modified_date>2026/09/05 19:10:00.000</modified_date>
    <key_for_session_key>H4sIAAAAAAAAAAMAAAAAAAAAAAA=</key_for_session_key>
    <is_key_private>N</is_key_private>
  </info>
  <notepads>
    <notepad>
      <note>Solo DIC_TABLAS / DIC_VARIABLES desde input_excel/legacy (Excel CAGR).
F2 multas+etapas: scripts/stage_csep_sheets.sh + f2_csep_sheets.json.
</note>
      <xloc>32</xloc>
      <yloc>32</yloc>
      <width>400</width>
      <heigth>80</heigth>
      <fontname>Arial</fontname>
      <fontsize>10</fontsize>
      <fontbold>N</fontbold>
      <fontitalic>N</fontitalic>
      <fontcolorred>0</fontcolorred>
      <fontcolorgreen>0</fontcolorgreen>
      <fontcolorblue>0</fontcolorblue>
      <backgroundcolorred>255</backgroundcolorred>
      <backgroundcolorgreen>255</backgroundcolorgreen>
      <backgroundcolorblue>255</backgroundcolorblue>
      <bordercolorred>100</bordercolorred>
      <bordercolorgreen>100</bordercolorgreen>
      <bordercolorblue>100</bordercolorblue>
      <drawshadow>Y</drawshadow>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Excel GS1 DIC_TABLAS</from>
      <to>H2 STG_GS1_DIC_TABLAS</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Excel GS1 DIC_VARIABLES</from>
      <to>H2 STG_GS1_DIC_VARIABLES</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <transform>
    <name>Excel GS1 DIC_TABLAS</name>
    <type>ExcelInput</type>
    <description>Hoja DIC_TABLAS -&gt; STG_GS1_DIC_TABLAS</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <header>Y</header>
    <noempty>Y</noempty>
    <stoponempty>N</stoponempty>
    <processing>Y</processing>
    <spreadsheet_type>POI</spreadsheet_type>
    <encoding/>
    <add_to_result_filenames>N</add_to_result_filenames>
    <accept_filenames>N</accept_filenames>
    <accept_field/>
    <accept_transform_name/>
    <sheetfield/>
    <fields>
    <field>
      <name>DATASET</name>
      <type>String</type>
      <length>-1</length>
      <precision>-1</precision>
      <trim_type>none</trim_type>
      <format></format>
      <currency/>
      <decimal/>
      <group/>
      <repeat>N</repeat>
    </field>
    <field>
      <name>DESCRIPCION_INSTRUCCIONES</name>
      <type>String</type>
      <length>-1</length>
      <precision>-1</precision>
      <trim_type>none</trim_type>
      <format></format>
      <currency/>
      <decimal/>
      <group/>
      <repeat>N</repeat>
    </field>
    </fields>
    <file>
      <name>${PROJECT_HOME}/input_excel/legacy/CAGR_ MA OEFA - 3) MULTAS COERCITIVAS.xlsx</name>
      <filemask/>
      <exclude_filemask/>
      <file_required>Y</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <sheets>
      <sheet>
        <name>DIC_TABLAS</name>
        <startrow>0</startrow>
        <startcol>0</startcol>
      </sheet>
    </sheets>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>H2 STG_GS1_DIC_TABLAS</name>
    <type>TableOutput</type>
    <description>Staging: carga a STG_GS1_DIC_TABLAS (H2 truncate)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>h2</connection>
    <schema>PUBLIC</schema>
    <table>STG_GS1_DIC_TABLAS</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>N</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <specify_fields>N</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>128</yloc>
    </GUI>
  </transform>
  <transform>
    <name>Excel GS1 DIC_VARIABLES</name>
    <type>ExcelInput</type>
    <description>Hoja DIC_VARIABLES -&gt; STG_GS1_DIC_VARIABLES</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <header>Y</header>
    <noempty>Y</noempty>
    <stoponempty>N</stoponempty>
    <processing>Y</processing>
    <spreadsheet_type>POI</spreadsheet_type>
    <encoding/>
    <add_to_result_filenames>N</add_to_result_filenames>
    <accept_filenames>N</accept_filenames>
    <accept_field/>
    <accept_transform_name/>
    <sheetfield/>
    <fields>
    <field>
      <name>DATASET</name>
      <type>String</type>
      <length>-1</length>
      <precision>-1</precision>
      <trim_type>none</trim_type>
      <format></format>
      <currency/>
      <decimal/>
      <group/>
      <repeat>N</repeat>
    </field>
    <field>
      <name>SECCION</name>
      <type>String</type>
      <length>-1</length>
      <precision>-1</precision>
      <trim_type>none</trim_type>
      <format></format>
      <currency/>
      <decimal/>
      <group/>
      <repeat>N</repeat>
    </field>
    <field>
      <name>CAMPO_EN_BD</name>
      <type>String</type>
      <length>-1</length>
      <precision>-1</precision>
      <trim_type>none</trim_type>
      <format></format>
      <currency/>
      <decimal/>
      <group/>
      <repeat>N</repeat>
    </field>
    <field>
      <name>CODIGO_CAMPO</name>
      <type>String</type>
      <length>-1</length>
      <precision>-1</precision>
      <trim_type>none</trim_type>
      <format></format>
      <currency/>
      <decimal/>
      <group/>
      <repeat>N</repeat>
    </field>
    <field>
      <name>CAMPO_NO_PUBLICABLE</name>
      <type>String</type>
      <length>-1</length>
      <precision>-1</precision>
      <trim_type>none</trim_type>
      <format></format>
      <currency/>
      <decimal/>
      <group/>
      <repeat>N</repeat>
    </field>
    <field>
      <name>NO_PUBLICABLE_PERO_NECESARIO_CSEP</name>
      <type>String</type>
      <length>-1</length>
      <precision>-1</precision>
      <trim_type>none</trim_type>
      <format></format>
      <currency/>
      <decimal/>
      <group/>
      <repeat>N</repeat>
    </field>
    <field>
      <name>VARIABLES_DE_LLENADO_MINIMO</name>
      <type>String</type>
      <length>-1</length>
      <precision>-1</precision>
      <trim_type>none</trim_type>
      <format></format>
      <currency/>
      <decimal/>
      <group/>
      <repeat>N</repeat>
    </field>
    <field>
      <name>DESCRIPCION</name>
      <type>String</type>
      <length>-1</length>
      <precision>-1</precision>
      <trim_type>none</trim_type>
      <format></format>
      <currency/>
      <decimal/>
      <group/>
      <repeat>N</repeat>
    </field>
    <field>
      <name>TIPO_DE_VARIABLE</name>
      <type>String</type>
      <length>-1</length>
      <precision>-1</precision>
      <trim_type>none</trim_type>
      <format></format>
      <currency/>
      <decimal/>
      <group/>
      <repeat>N</repeat>
    </field>
    </fields>
    <file>
      <name>${PROJECT_HOME}/input_excel/legacy/CAGR_ MA OEFA - 3) MULTAS COERCITIVAS.xlsx</name>
      <filemask/>
      <exclude_filemask/>
      <file_required>Y</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <sheets>
      <sheet>
        <name>DIC_VARIABLES</name>
        <startrow>0</startrow>
        <startcol>0</startcol>
      </sheet>
    </sheets>
    <attributes/>
    <GUI>
      <xloc>128</xloc>
      <yloc>288</yloc>
    </GUI>
  </transform>
  <transform>
    <name>H2 STG_GS1_DIC_VARIABLES</name>
    <type>TableOutput</type>
    <description>Staging: carga a STG_GS1_DIC_VARIABLES (H2 truncate)</description>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <connection>h2</connection>
    <schema>PUBLIC</schema>
    <table>STG_GS1_DIC_VARIABLES</table>
    <commit>1000</commit>
    <truncate>Y</truncate>
    <only_when_have_rows>N</only_when_have_rows>
    <ignore_errors>N</ignore_errors>
    <use_batch>Y</use_batch>
    <partitioning_enabled>N</partitioning_enabled>
    <partitioning_field/>
    <partitioning_daily>N</partitioning_daily>
    <partitioning_monthly>N</partitioning_monthly>
    <tablename_in_field>N</tablename_in_field>
    <tablename_field/>
    <tablename_in_table>N</tablename_in_table>
    <return_keys>N</return_keys>
    <return_field/>
    <specify_fields>N</specify_fields>
    <auto_update_table_structure>N</auto_update_table_structure>
    <always_drop_and_recreate>N</always_drop_and_recreate>
    <add_columns>N</add_columns>
    <drop_columns>N</drop_columns>
    <change_column_types>N</change_column_types>
    <attributes/>
    <GUI>
      <xloc>400</xloc>
      <yloc>288</yloc>
    </GUI>
  </transform>
  <transform_error_handling>
  </transform_error_handling>
</pipeline>
