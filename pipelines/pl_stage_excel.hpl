      <fontname>Segoe UI</fontname>
      <fontsize>11</fontsize>
      <height>90</height>
      <xloc>32</xloc>
      <yloc>16</yloc>
      <note>Extract Excel local (sin logica). Header = fila de codigos.
GS1 Multas: fila 3 (startrow 2). GS1 Etapas: fila 2 (startrow 1). GS2 Multas: fila 3.
Todos los campos String: MULTA_S y otros traen #N/A.</note>
      <width>640</width>
    </notepad>
  </notepads>
  <order>
    <hop>
      <from>Excel GS1 Multas</from>
      <to>H2 STG_GS1_MULTAS_COERCITIVAS</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Excel GS1 Etapas</from>
      <to>H2 STG_GS1_ETAPAS</to>
